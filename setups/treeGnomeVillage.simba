function TreeGnomeVillageStart(): Boolean;
begin
  if not (Inventory.CountItem('Logs') >= 6) then RaiseException('Not enough logs in inventory');
  Result := True;
end;

procedure SetupTreeGnomeVillage();
begin
  GENERATED_GRAPH.NodeRadius := 20;
  Quest.region := [[[38, 49, 40, 51],[0]]];
  Quest.StartingConditions := @TreeGnomeVillageStart;
